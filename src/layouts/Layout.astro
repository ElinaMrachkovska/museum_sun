---
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import { stripBase } from '../utils/url.js';
import '../styles/main.scss';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Музей «Від Русі до України. Кам’янець крізь віки» — Кам’янець-Подільський, площа Польський ринок, 19. Тисячолітня історія державності та таємниці Кам’янця.'
} = Astro.props;
const fullTitle = title ? `${title} — музей «Від Русі до України»` : 'Від Русі до України — музей, Кам’янець-Подільський';
const currentPath = stripBase(Astro.url.pathname);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header client:load currentPath={currentPath} />
    <main class="main">
      <slot />
    </main>
    <Footer />
    <div class="curtain" aria-hidden="true">
      <span class="curtain__mark">Від Русі до України</span>
    </div>

    <script>
      import initInteractiveFx from '../scripts/interactive-fx.js';
      import initPageTransition from '../scripts/page-transition.js';

      initInteractiveFx();
      initPageTransition();
    </script>
  </body>
</html>
