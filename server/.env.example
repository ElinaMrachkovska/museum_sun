# ---------- Сервер ----------
PORT=3001
# Адреса фронтенду (з базовим шляхом). Туди повертається відвідувач після оплати.
CLIENT_URL=http://localhost:4321/museum_sun
# Дозволені джерела для CORS (через кому)
CORS_ORIGINS=http://localhost:4321,https://elinamrachkovska.github.io
# Публічна адреса ЦЬОГО сервера — на неї LiqPay і Monobank надсилають повідомлення про оплату.
# Локально можна використати тунель (наприклад, ngrok): https://xxxx.ngrok-free.app
PUBLIC_SERVER_URL=http://localhost:3001

# ---------- Astra DB (astra.datastax.com → ваша база → Connect) ----------
# Якщо порожні — сервер працює з локальним файлом server/data/dev-db.json
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=default_keyspace

# ---------- LiqPay (liqpay.ua → Кабінет → Налаштування → API) ----------
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# 1 — тестовий режим (гроші не списуються), 0 — бойовий
LIQPAY_SANDBOX=1

# ---------- Monobank acquiring (api.monobank.ua → тестовий токен / web.monobank.ua) ----------
MONO_TOKEN=
